# Production / Neon development. Copy to .env.local, then fill real values.
DATABASE_DRIVER=neon
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=your-random-secret-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000
# Optional for explicit local PostgreSQL development (pnpm dev:local sets this).
# LOCAL_DATABASE_PATH=.local/database
# No AI, storage, payment, or workflow credentials are used in Phase 0.
